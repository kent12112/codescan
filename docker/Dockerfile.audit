FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
RUN pip install --no-cache-dir pip-audit==2.10.1
ENV PIP_AUDIT_CACHE_DIR=/tmp/audit-cache
CMD ["sh", "-c", "for lock in /locks/*.lock; do pip-audit --cache-dir /tmp/audit-cache --strict --disable-pip --no-deps --progress-spinner off -r \"$lock\" || exit 1; done"]
