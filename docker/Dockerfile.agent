FROM python:3.12-slim
RUN pip install --no-cache-dir anthropic && useradd --create-home --uid 1000 agent
COPY codescan /home/agent/codescan
COPY egress/agent_run.py /home/agent/agent_run.py
COPY egress/agent_server.py /home/agent/agent_server.py
WORKDIR /home/agent
USER agent
ENV PYTHONPATH=/home/agent PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "agent_server.py"]
