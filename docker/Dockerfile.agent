FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
COPY dependencies/agent.lock /tmp/runtime.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/runtime.lock && useradd --create-home --uid 1000 agent
COPY codescan /home/agent/codescan
COPY service /home/agent/service
WORKDIR /home/agent
USER agent
ENV PYTHONPATH=/home/agent PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 REQUIRE_GATEWAY=1 SERVICE_BIND=0.0.0.0:9000
ENTRYPOINT ["gunicorn", "-c", "service/gunicorn_config.py", "service.analyst:create_app()"]
